      "name": "Positive_TCs",
      "item": [
        {
          "name": "Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {\n    pm.response.to.have.status(201);\n});\n\nvar jsonData = pm.response.json();\nif (jsonData && jsonData.id) {\n    pm.environment.set(\"userId\", jsonData.id);\n}"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.iterationData.get(\"email\")) {\r\n    var usersList = [\r\n        { \"name\": \"Nguyen Minh Nhat\", \"gender\": \"male\", \"email\": \"bioenondamicright\", \"domain\": \"@gmail.com\", \"status\": \"active\" },\r\n        { \"name\": \"Nguyen Thien Thao\", \"gender\": \"female\", \"email\": \"anh2k9\", \"domain\": \"@gmail.com\", \"status\": \"active\" },\r\n        { \"name\": \"Nguyen Thien Minh Bun\", \"gender\": \"male\", \"email\": \"bunbunne\", \"domain\": \"@gmail.com\", \"status\": \"active\" }\r\n    ];\r\n\r\n    var currentIndex = parseInt(pm.collectionVariables.get(\"user_index\") || \"0\");\r\n    var currentUser = usersList[currentIndex];\r\n\r\n    // Tạo email động bằng cách ghép chuỗi thời gian Date.now() để không bao giờ bị trùng\r\n    var uniqueEmail = currentUser.email + \"_\" + Date.now() + currentUser.domain;\r\n\r\n    pm.variables.set(\"name\", currentUser.name);\r\n    pm.variables.set(\"gender\", currentUser.gender);\r\n    pm.variables.set(\"email\", uniqueEmail);\r\n    pm.variables.set(\"status\", currentUser.status);\r\n\r\n    var nextIndex = (currentIndex + 1) % usersList.length;\r\n    pm.collectionVariables.set(\"user_index\", nextIndex);\r\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"name\": \"{{name}}\",\r\n  \"gender\": \"{{gender}}\",\r\n  \"email\": \"{{email}}\",\r\n  \"status\": \"{{status}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseurl}}/users",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
                "users"
              ]
            }
          },
          "response": []
        },
        {
