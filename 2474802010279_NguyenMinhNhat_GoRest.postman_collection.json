        {
          "name": "Duplicate Email",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var targetEmail = \"dup_test_\" + Date.now() + \"@gmail.com\";",
                  "pm.variables.set(\"dup_email\", targetEmail);",
                  "",
                  "var baseUrl = pm.environment.get(\"baseurl\") || \"https://gorest.co.in/public/v2\";",
                  "var token = pm.environment.get(\"token\");",
                  "",
                  "pm.sendRequest({",
                  "    url: baseUrl + \"/users\",",
                  "    method: 'POST',",
                  "    header: {",
                  "        'Content-Type': 'application/json',",
                  "        'Authorization': 'Bearer ' + token",
                  "    },",
                  "    body: {",
                  "        mode: 'raw',",
                  "        raw: JSON.stringify({",
                  "            name: \"Duplicate Base User\",",
                  "            gender: \"male\",",
                  "            email: targetEmail,",
                  "            status: \"active\"",
                  "        })",
                  "    }",
                  "}, function (err, res) {});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 422 Unprocessable Entity\", function () {\r\n    pm.response.to.have.status(422);\r\n});"
                ]
              }
            }
          ],
